    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Lifted 5 units: optical centre of the mark. -->
    <group android:translateY="-5">
    <!-- Arc track -->
    <path
        android:pathData="M30,66 A24,24 0 0,1 78,66"
        android:strokeWidth="4.5"
        android:strokeColor="#331E1810"
        android:strokeLineCap="round" />
    <!-- Travelled part -->
    <path
        android:pathData="M30,66 A24,24 0 0,1 66.8,45.9"
        android:strokeWidth="4.5"
        android:strokeColor="#FFE8A54B"
        android:strokeLineCap="round" />
    <!-- Horizon -->
    <path
        android:pathData="M25,71 L83,71"
        android:strokeWidth="3"
        android:strokeColor="#FF1E1810"
        android:strokeLineCap="round" />
    <!-- Sun -->
    <path
        android:fillColor="#FFF8F4E8"
        android:pathData="M66.8,45.9 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
    <path
        android:fillColor="#FFE8A54B"
        android:pathData="M66.8,45.9 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    </group>
</vector>
